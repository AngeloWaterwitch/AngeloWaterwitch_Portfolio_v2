generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model HeroContent {
  id            String   @id @default(cuid())
  name          String
  role          String
  sub           String
  resumeEnabled Boolean  @default(true)
  resumeUrl     String?
  resumeLabel   String   @default("Download CV")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AboutContent {
  id        String   @id @default(cuid())
  bio1      String
  bio2      String
  years     String
  projects  String
  clients   String
  standing  String
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id        String   @id @default(cuid())
  icon      String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        String         @id @default(cuid())
  title     String
  desc      String
  tags      String[]
  link      String?
  order     Int            @default(0)
  media     ProjectMedia[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ProjectMedia {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  type      String   @default("image")
  createdAt DateTime @default(now())
}

model Service {
  id        String   @id @default(cuid())
  num       String
  title     String
  desc      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimelineEvent {
  id           String   @id @default(cuid())
  type         String
  title        String
  organisation String
  period       String
  desc         String
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id        String            @id @default(cuid())
  quote     String
  author    String
  role      String?
  status    TestimonialStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

model ContactInfo {
  id        String   @id @default(cuid())
  email     String
  phone     String?
  location  String?
  facebook  String?
  linkedin  String?
  instagram String?
  github    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SEOSettings {
  id            String   @id @default(cuid())
  title         String
  description   String
  keywords      String?
  ogImage       String?
  twitterHandle String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Branding {
  id          String   @id @default(cuid())
  logoText    String   @default("AW.")
  logoUrl     String?
  faviconUrl  String? // add this line
  displayFont String   @default("Syne")
  monoFont    String   @default("Space Mono")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSection {
  id        String   @id @default(cuid())
  sectionId String   @unique
  label     String
  visible   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  detail    String
  userId    String?
  createdAt DateTime @default(now())
}

model ResumeFile {
  id        String   @id @default(cuid())
  url       String
  filename  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ThemeSettings {
  id           String   @id @default(cuid())
  primaryColor String   @default("hsl(348, 100%, 40%)")
  primaryLight String   @default("hsl(348, 100%, 55%)")
  primaryDim   String   @default("hsl(348, 60%, 25%)")
  bgDark       String   @default("#0a0a0a")
  bgDark2      String   @default("#111111")
  bgDark3      String   @default("#1a1a1a")
  bgDark4      String   @default("#222222")
  textLight    String   @default("#f0ede8")
  displayFont  String   @default("Syne")
  monoFont     String   @default("Space Mono")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ResumeRequest {
  id          String              @id @default(cuid())
  email       String
  reason      String
  status      ResumeRequestStatus @default(PENDING)
  token       String              @unique @default(cuid())
  tokenExpiry DateTime
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

enum ResumeRequestStatus {
  PENDING
  APPROVED
  DENIED
}

model SiteSettings {
  id               String   @id @default(cuid())
  footerTagline    String   @default("Software & Design Engineer based in Cape Town, South Africa.")
  footerCopyright  String   @default("Angelo Waterwitch")
  footerCredit     String   @default("Designed & Built by Angelo Waterwitch")
  showFooterCredit Boolean  @default(true)
  showAdminLink    Boolean  @default(false)
  navCtaLabel      String?
  navCtaUrl        String?
  legalLinks       Json     @default("[]")
  sectionHeadings  Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Client platform (Phase 4) ──────────────────────────────

enum ClientStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  QUOTED
  DEPOSIT_PENDING
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

model Client {
  id             String          @id @default(cuid())
  name           String
  email          String
  phone          String?
  company        String?
  status         ClientStatus    @default(ACTIVE)
  // The access code is never stored. Only a keyed hash (for lookup) and the last 4 characters (so you can tell codes apart).
  accessCodeHash String          @unique
  accessCodeHint String
  codeIssuedAt   DateTime        @default(now())
  codeExpiresAt  DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  projects       ClientProject[]
  sessions       ClientSession[]
  chatMessages   ChatMessage[]
  calls          CallSession[]
}

model ClientProject {
  id               String            @id @default(cuid())
  clientId         String
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title            String
  description      String            @default("")
  status           ProjectStatus     @default(QUOTED)
  progress         Int               @default(0)
  currency         String            @default("ZAR")
  totalCents       Int               @default(0)
  depositCents     Int               @default(0)
  depositPaidAt    DateTime?
  finalPaidAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  updates          ProgressUpdate[]
  workSessions     WorkSession[]
  overtimeRequests OvertimeRequest[]
  logEntries       WorkLogEntry[]

  @@index([clientId])
}

model ProgressUpdate {
  id              String        @id @default(cuid())
  projectId       String
  project         ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  body            String        @default("")
  progress        Int?
  visibleToClient Boolean       @default(true)
  createdAt       DateTime      @default(now())

  @@index([projectId, createdAt])
}

model ClientSession {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([clientId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorType String
  actorId   String?
  action    String
  detail    Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorType, actorId])
}

// ─── Work log & overtime (Phase 4, slice 2) ─────────────────

enum OvertimeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model WorkSession {
  id                String        @id @default(cuid())
  projectId         String
  project           ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startedAt         DateTime
  endedAt           DateTime?
  summary           String        @default("")
  overtime          Boolean       @default(false)
  overtimeRequestId String?
  createdAt         DateTime      @default(now())

  @@index([projectId, startedAt])
}

model OvertimeRequest {
  id               String         @id @default(cuid())
  projectId        String
  project          ClientProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reason           String
  estimatedMinutes Int
  plannedFor       DateTime?
  status           OvertimeStatus @default(PENDING)
  clientNote       String         @default("")
  decidedAt        DateTime?
  createdAt        DateTime       @default(now())

  @@index([projectId, createdAt])
}

model WorkLogEntry {
  id              String        @id @default(cuid())
  projectId       String
  project         ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessionId       String?
  kind            String
  message         String
  visibleToClient Boolean       @default(true)
  createdAt       DateTime      @default(now())

  @@index([projectId, createdAt])
}

// ─── Chat & calls (Phase 4, slice 3) ────────────────────────

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
  CANCELLED
}

model ChatMessage {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sender    String // ADMIN | CLIENT | SYSTEM
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId, createdAt])
}

model CallSession {
  id          String     @id @default(cuid())
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  initiatedBy String // ADMIN | CLIENT
  kind        String // AUDIO | VIDEO
  status      CallStatus @default(RINGING)
  roomName    String     @unique
  answeredAt  DateTime?
  endedAt     DateTime?
  createdAt   DateTime   @default(now())

  @@index([clientId, createdAt])
}
